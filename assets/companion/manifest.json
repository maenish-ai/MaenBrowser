{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.8.5",
  "description": "__MSG_extensionDescription__",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "downloads",
    "scripting",
    "sessions",
    "tabGroups",
    "sidePanel",
    "management",
    "downloads.open"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "chrome_url_overrides": {
    "newtab": "start.html"
  },
  "side_panel": {
    "default_path": "tabs.html"
  },
  "commands": {
    "open-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "__MSG_tabsCommand__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://maen.browser"
  },
  "default_locale": "en"
}
